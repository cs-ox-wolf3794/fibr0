# Copy to .env for local development. Never commit .env.
# In CI these come from GitHub Actions secrets. On Vercel, from project env vars.

# Supabase Postgres connection string (pipeline only; bypasses row-level security).
# Use the SESSION POOLER string: dashboard -> Connect -> Session pooler. The direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from GitHub Actions.
DATABASE_URL=postgresql://postgres.qfnjwhoizlxbigzdzbly:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Anthropic API key. The SDK reads this automatically.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
FIBR0_MODEL=claude-opus-5
# When set, the analyze stage reads events from this JSON file instead of Postgres
# and makes synchronous calls. Use during development to protect the API budget.
# FIBR0_FIXTURE=pipeline/tests/fixtures/events.json
# When true, no LLM calls are made and no rows are written. Stages log what they would do.
FIBR0_DRY_RUN=false
